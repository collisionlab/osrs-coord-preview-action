#!/usr/bin/env python3
"""Check two Action manifests and fetch their public preview PNGs."""
import json
from pathlib import Path
import re
import sys
import urllib.request

first, second = [json.loads(Path(p).read_text()) for p in sys.argv[1:]]
for manifest in (first, second):
    assert manifest['renderCount'] == 2 and manifest['failedCount'] == 0, manifest
urls = [item['imageUrl'] for item in first['items']]
assert urls == [item['imageUrl'] for item in second['items']]
for url in urls:
    assert re.fullmatch(r'https://tiles\.collisionlab\.world/previews/images/[a-f0-9]{64}\.png', url), url
    with urllib.request.urlopen(url, timeout=30) as response:
        assert response.status == 200
        assert response.headers.get_content_type() == 'image/png'
        assert 'immutable' in response.headers['cache-control']
        assert response.read(8) == b'\x89PNG\r\n\x1a\n'
print('Ground/upper-plane PNGs and repeated image identity passed.')
